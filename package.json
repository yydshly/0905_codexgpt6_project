{
  "name": "ideal-study",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages --outDir dist-pages",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:pages": "vite preview --mode pages --outDir dist-pages --host 127.0.0.1 --port 4174 --strictPort",
    "test": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "lucide": "0.468.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/three": "0.180.0",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
